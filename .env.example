# AI StudySense Environment Configuration

# Application
APP_NAME=AI StudySense
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=studysense-dev-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./studysense.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hardware & ESP32 Configuration
ESP32_API_KEY=studysense_esp32_device_secret_2026
ESP32_WS_PATH=/ws/esp32

# Computer Vision & Posture Engine
POSTURE_BUFFER_SECONDS=5.0
POSTURE_BAD_THRESHOLD_SECONDS=10.0
POSTURE_ANGLE_THRESHOLD=25.0
CAMERA_INDEX=0
ENABLE_MOOD_ANALYSIS=False
